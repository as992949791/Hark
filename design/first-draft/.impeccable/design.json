    {
      "name": "Feature Filter",
      "kind": "chip",
      "refersTo": "feature-filter",
      "description": "Selected and unselected feature controls; sample state is explicit through aria-pressed.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Example feature controls\"><button class=\"ds-filter\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>Reddit &amp; X</button><button class=\"ds-filter\" aria-pressed=\"false\">Insights</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:8px}.ds-filter{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:11px 15px;border:1px solid var(--line,#e0e6ed);border-radius:8px;background:var(--paper,#fff);color:var(--ink,#172b3b);font-size:13px;font-weight:500;cursor:pointer;font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);transition:background .16s,color .16s,box-shadow .16s;}.ds-filter:hover{background:var(--soft,#edf2f7)}.ds-filter[aria-pressed=true]{background:var(--blue-soft,#edf3ff);color:var(--blue,#2458d5);border-color:var(--blue,#2458d5)}.ds-filter:focus-visible{outline:2px solid var(--blue,#2458d5);outline-offset:4px;}.ds-filter:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-dark,.ds-subtle,.ds-link,.ds-filter,.ds-nav button,.ds-lead{transition:none;}}"
    },
    {
      "name": "Fit Tag",
      "kind": "chip",
      "refersTo": "fit-tag",
      "description": "Static fit information, not an interactive control.",
      "html": "<span class=\"ds-fit\">91 fit · example</span>",
      "css": ".ds-fit{display:inline-block;padding:4px 7px;border-radius:5px;background:var(--green-soft,#edf6f1);color:var(--green,#247052);font-size:10px;white-space:nowrap;font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);}"
    },
    {
      "name": "Evidence Surface",
      "kind": "card",
      "refersTo": "evidence-surface",
      "description": "Opaque bordered reading container; this sample omits decorative preview framing.",
      "html": "<article class=\"ds-evidence\"><header class=\"ds-evidence-header\"><h2>The conversation</h2><span>Example</span></header><p class=\"ds-evidence-copy\">I need a simple editor that handles captions and lets me fix the details.</p><blockquote class=\"ds-evidence-quote\"><mark>I spend more time fixing captions than editing the video.</mark></blockquote></article>",
      "css": ".ds-evidence{max-width:72ch;overflow:hidden;border:1px solid var(--line,#e0e6ed);border-radius:var(--radius,12px);background:var(--paper,#fff);color:var(--ink,#172b3b);font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);}.ds-evidence-header{display:flex;align-items:center;gap:7px;padding:25px 26px 19px;border-bottom:1px solid var(--line,#e0e6ed)}.ds-evidence-header h2{margin:0;font-size:12px;font-weight:550}.ds-evidence-header span{margin-left:auto;color:var(--muted,#596b7b);font-size:9px}.ds-evidence-copy{max-width:72ch;margin:24px 26px 16px;font-size:14px;line-height:1.8;color:var(--muted,#596b7b)}.ds-evidence-quote{max-width:72ch;margin:15px 26px 24px;font-size:14px;line-height:1.8;font-weight:500}.ds-evidence-quote mark{padding:3px 0;background:var(--blue-soft,#edf3ff);color:var(--ink,#172b3b);box-decoration-break:clone;-webkit-box-decoration-break:clone}.ds-evidence ::selection{background:var(--blue-soft,#edf3ff);color:var(--ink,#172b3b)}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "description": "Navy navigation with a pale selected row and a measured count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example workspace navigation\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg><span>Reddit leads</span><span class=\"ds-count\">6</span></button><button><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><span>X leads</span></button></nav>",
      "css": ".ds-nav{width:208px;padding:16px;background:var(--nav,#112b3d);color:var(--nav-muted,#b3c6d3);font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);}.ds-nav button{display:flex;align-items:center;gap:11px;width:100%;min-height:34px;padding:9px 10px;border:0;border-radius:6px;background:none;color:var(--nav-muted,#b3c6d3);text-align:left;font-size:12px;cursor:pointer;font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);transition:background .16s,color .16s,box-shadow .16s;}.ds-nav button:hover{background:#234457}.ds-nav button[aria-current=page]{background:linear-gradient(110deg,#d9eaff,#e5f7fa);color:#173d78;font-weight:550}.ds-nav button:focus-visible{outline:2px solid var(--blue,#2458d5);outline-offset:4px;}.ds-nav button:active{transform:translateY(1px)}.ds-count{margin-left:auto;font-family:JetBrains,monospace;font-size:10px;opacity:.8}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-dark,.ds-subtle,.ds-link,.ds-filter,.ds-nav button,.ds-lead{transition:none;}}"
    },
    {
      "name": "Conversation Row",
      "kind": "custom",
      "refersTo": "lead-row",
      "description": "A selected conversation pairs source context, a readable title and a fit measurement.",
      "html": "<button class=\"ds-lead\" aria-pressed=\"true\"><span class=\"ds-lead-meta\">r/VideoEditing <time>2h ago</time></span><strong class=\"ds-lead-title\">Is there a better way to caption short videos?</strong><span class=\"ds-lead-bottom\"><span>Asking for a tool · example</span><strong>91<small> fit</small></strong></span></button>",
      "css": ".ds-lead{display:block;width:100%;padding:16px;border:0;border-bottom:1px solid var(--line,#e0e6ed);background:var(--paper,#fff);color:var(--ink,#172b3b);text-align:left;cursor:pointer;font-family:var(--font,Instrument,\"PingFang SC\",sans-serif);transition:background .16s,color .16s,box-shadow .16s;}.ds-lead:hover{background:var(--ground,#f5f7fa)}.ds-lead[aria-pressed=true]{background:linear-gradient(110deg,var(--blue-soft,#edf3ff),var(--cyan-soft,#e9f9fb))}.ds-lead[aria-pressed=true] .ds-lead-title{color:var(--blue,#2458d5)}.ds-lead:focus-visible{outline:2px solid var(--blue,#2458d5);outline-offset:4px;}.ds-lead:active{transform:translateY(1px)}.ds-lead-meta{display:flex;gap:6px;color:var(--muted,#596b7b);font-size:11px}.ds-lead-meta time{margin-left:auto}.ds-lead-title{display:block;max-width:310px;margin-top:8px;font-size:14px;line-height:1.5;font-weight:550}.ds-lead-bottom{display:flex;justify-content:space-between;gap:10px;margin-top:10px;font-size:11px;color:var(--muted,#596b7b)}.ds-lead-bottom>strong{font:500 11px JetBrains,monospace;color:var(--green,#247052)}.ds-lead-bottom small{font:9px var(--font,Instrument,sans-serif)}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-dark,.ds-subtle,.ds-link,.ds-filter,.ds-nav button,.ds-lead{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Open sky, attentive listening (provisional)",
    "overview": "This is a local code-first proposal, not an approved production identity. It records the implemented `app.tsx` and `style.css` within this directory only (source baseline `26d0368`). The user-confirmed direction is a Lurk-inspired blue sky, white clouds, subtle gradients, fuller homepage controls and a shared workspace. The metaphor above describes that direction; it does not establish a new brand name or commitment.\n\nAn airy sky introduces the product; cool paper carries conversations and their evidence. Navy navigation, blue actions, restrained green fit signals and the same type families connect the public and working surfaces. The prototype's logo, typography and replacement layout remain proposals. Surface composition belongs to the root surface brief; this document records reusable visual behavior.",
    "keyCharacteristics": [
      "Diffuse CSS clouds and bounded blue-to-cyan gradients.",
      "Opaque reading surfaces with compact, clearly selected controls.",
      "Instrument Sans for language; JetBrains Mono for fit measurements.",
      "Theme-aware color pairs and responsive list/detail navigation."
    ],
    "rules": [
      {
        "name": "The Bounded Gradient Rule",
        "body": "Gradients remain bounded by sky stages, actions and supporting surfaces. Long conversation text stays on opaque paper; text itself is not gradient-filled.",
        "section": "colors"
      },
      {
        "name": "The Data Numeral Rule",
        "body": "Mono communicates fit measurements and meaningful step numbers; prose and navigation keep the sans voice.",
        "section": "typography"
      },
      {
        "name": "The Reading Surface Rule",
        "body": "Conversation text and persistent action rows sit on opaque paper, even when surrounding workspace accents use gradients.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep long evidence on opaque paper with a bounded reading measure.",
      "**Do** carry blue selection, fit green and navy navigation across both surfaces.",
      "**Do** preserve themed focus, selection, caret and reduced-motion behavior.",
      "**Do** identify synthetic examples near the content they describe."
    ],
    "donts": [
      "**Don't** fill text with gradients or let cloud decoration reduce reading contrast.",
      "**Don't** present this local proposal's mark, font selection or layout as an approved Hark identity.",
      "**Don't** promote tiny preview metadata, decorative source glyphs or border-plus-shadow preview frames into reusable component defaults."
    ]
  }
}
