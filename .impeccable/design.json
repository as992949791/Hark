  "narrative": {
    "northStar": "Sky/cloud stage and navy workspace",
    "overview": "Hark pairs an airy public expression with a compact working application. Both use Instrument Sans, cool paper, clear blue actions, fine borders and rounded controls. The homepage carries the confirmed sky/cloud background, blue/violet/rose gradient lettering and computer/iPhone framing. The authenticated shell uses navy navigation and opaque content surfaces so conversations, reasons and controls remain readable.\n\nThis records the implemented homepage and shared workspace palette, header and rail. The homepage was integrated from the selected interactive code prototype; there is no approved raster composition or new shipping raster. Its composition and story remain in the [surface brief](.impeccable/surfaces/src-components-marketing-home-experience-tsx.md). Existing individual modules have layout smoke checks, not complete interaction acceptance. Cross-platform public-web discovery remains planned, and this record does not establish a public deployment.",
    "keyCharacteristics": [
      "Cool neutral content surfaces with blue actions and navy application navigation.",
      "Readable conversation evidence, compact controls and restrained mono metadata.",
      "Rounded, opaque working surfaces; atmospheric glass and hardware framing on the public homepage.",
      "Theme-aware semantic tones and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Change a background and its intended foreground together. Solid green illustration badges use white in light mode and the dark page-ground foreground in dark mode; judgement text uses the semantic score tone on ordinary or selected surfaces.",
        "section": "colors"
      },
      {
        "name": "The Evidence Hierarchy Rule",
        "body": "Conversation titles and quoted evidence keep the reading sans. Use mono selectively for compact comparison or technical context; do not turn body copy into a data label.",
        "section": "typography"
      },
      {
        "name": "The Opaque Evidence Rule",
        "body": "Put real conversation reading and form controls on opaque semantic surfaces. Keep sky, clouds, glass and device shadows within the public presentation and existing illustrative components.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the semantic light/dark pairs and keep real conversation and form surfaces opaque.",
      "**Do** preserve Instrument Sans for reading and apply JetBrains Mono selectively to compact metadata or technical content.",
      "**Do** preserve the navy rail, reachable sticky header, project context and narrow-screen drawer behavior.",
      "**Do** keep keyboard focus visible and retain the existing reduced-motion and forced-color fallbacks.",
      "**Do** identify synthetic public previews and keep their fixture state separate from live workspace data."
    ],
    "donts": [
      "**Don't** extend homepage sky, glass, headline gradients or hardware framing into every application module.",
      "**Don't** add the prototype-only homepage/workspace switcher to production navigation.",
      "**Don't** represent planned public-web discovery, live scans or unverified module interactions as completed capabilities.",
      "**Don't** treat inherited uppercase rail group labels or unresolved secondary-button hover aliases as house-style rules."
    ]
  }
